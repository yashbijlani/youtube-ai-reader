# ------------------------------------------------------------------
# YouTube AI Reader — backend environment
# Copy to backend/.env and fill in. NEVER commit real secrets.
# ------------------------------------------------------------------

# --- AI provider (server-side only; never shipped to the browser) ---
# Any OpenAI-compatible endpoint works: Google Gemini, OpenCode Zen, OpenAI,
# OpenRouter, Groq, Ollama, vLLM, LM Studio, ...
#
# Two tiers: OPENCODE_MODEL = quality (detailed reading + chat),
#            OPENCODE_FAST_MODEL = fast/cheap (quick-read + overview + chapters).
#
# Recommended: route both through OpenRouter (one key, any model, spend caps).
# OPENCODE_BASE_URL=https://openrouter.ai/api/v1
# OPENCODE_MODEL=anthropic/claude-sonnet-5
# OPENCODE_FAST_MODEL=google/gemini-3.5-flash-lite
#
# Gemini (Google AI Studio) two-tier example:
OPENCODE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENCODE_API_KEY=
OPENCODE_MODEL=gemini-3.8-flash
OPENCODE_FAST_MODEL=gemini-3.5-flash-lite
OPENCODE_TIMEOUT_SECONDS=240
OPENCODE_MAX_CONCURRENCY=3
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=8192
AI_HARD_MAX_OUTPUT_TOKENS=16000
AI_MAX_RETRIES=2
# Probe the provider before spending a YouTube fetch (fails fast on 402/403/404).
AI_PREFLIGHT_ENABLED=true

# --- Monetization (free previews) ---
# Distinct videos a free install can process before the paywall.
FREE_VIDEO_LIMIT=3
USAGE_ENABLED=true

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data

# Log every state poll (GET /api/videos/{id}); off keeps the logs quiet.
LOG_POLL_REQUESTS=false

# Comma-separated exact origins (empty by default; regex below covers dev).
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=^(chrome-extension://.*|http://localhost(:\d+)?|http://127\.0\.0\.1(:\d+)?)$
TRUST_PROXY=false

# --- YouTube / yt-dlp (anti-throttling) ---
YTDLP_TIMEOUT_SECONDS=180
YTDLP_MAX_RETRIES=2
# Serialise YouTube requests and space them out to avoid HTTP 429.
YTDLP_CONCURRENCY=1
YTDLP_MIN_INTERVAL_SECONDS=4
YTDLP_429_MAX_RETRIES=1
YTDLP_429_BACKOFF_SECONDS=8
# Optional cookies make requests much less likely to be throttled (server-side only).
# Export cookies to a Netscape-format file, e.g. via a browser extension, then:
YTDLP_COOKIES_FILE=
# Or read cookies directly from a browser profile on the server (chrome, firefox, ...):
YTDLP_COOKIES_FROM_BROWSER=
# Optional yt-dlp player client override, e.g. web_safari, tv, web.
YTDLP_PLAYER_CLIENT=
# Use youtube-transcript-api as a fallback caption source when yt-dlp is throttled.
TRANSCRIPT_FALLBACK_ENABLED=true

MAX_TRANSCRIPT_CHARS=900000
MAX_CHAT_MESSAGE_CHARS=2000
MAX_CONCURRENT_JOBS=3
JOB_QUEUE_TIMEOUT_SECONDS=45
CACHE_ENABLED=true
PROMPT_VERSION=1
# Trust transcripts posted by the extension (captured in the user's own session).
# For a multi-tenant hosted deployment, set false and scope client transcripts per session.
TRUST_CLIENT_TRANSCRIPTS=true

# --- Client-facing rate limits (per IP) ---
RATE_LIMIT_PROCESS_PER_HOUR=10
RATE_LIMIT_CHAT_PER_HOUR=60
RATE_LIMIT_GENERAL_PER_MINUTE=240

# --- Analysis sizing ---
CHUNK_TARGET_CHARS=1200
CHUNK_MAX_CHARS=1800
# Digest budget for the overview + chapters (whole-timeline, snippet per chunk).
OVERVIEW_CONTEXT_CHARS=14000
# Detailed-reading sections written in parallel (each streams token-by-token).
ANALYSIS_READING_CONCURRENCY=2
MAX_READING_SECTIONS=8
READING_SECTION_CHARS=10000
CHAT_TOP_K=6
CHAT_CONTEXT_CHARS=12000
