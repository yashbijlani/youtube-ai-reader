# ------------------------------------------------------------------
# YouTube AI Reader — backend environment
# Copy to backend/.env and fill in. NEVER commit real secrets.
#
# Canonical names: GEMINI_* / SUPABASE_* / RAZORPAY_*. Legacy OPENCODE_* names
# are accepted as aliases for backward compatibility.
# ------------------------------------------------------------------

# --- Runtime ---
ENVIRONMENT=development            # development | production
PUBLIC_APP_URL=http://localhost:8000

# --- AI provider (server-side only; never shipped to the browser) ---
# Production uses the native Gemini API. Two tiers:
#   GEMINI_MODEL_MAIN = quality  (detailed reading + chat)
#   GEMINI_MODEL_FAST = cheap    (summary, overview, chapters, classification)
#
# DeepSeek (OpenAI-compatible) example — replaces Gemini entirely:
#   AI_PROVIDER=openai_compatible
#   GEMINI_BASE_URL=https://api.deepseek.com
#   GEMINI_API_KEY=<deepseek key>
#   GEMINI_MODEL_MAIN=deepseek-flash      # DeepSeek-V4.1-Flash
#   GEMINI_MODEL_FAST=deepseek-flash
#   (DeepSeek reasoning models may need a larger AI_HARD_MAX_OUTPUT_TOKENS.)
AI_PROVIDER=gemini                 # gemini | openai_compatible (any OpenAI-compatible API)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=240
GEMINI_CONNECT_TIMEOUT_SECONDS=15
GEMINI_MAX_CONCURRENCY=6
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=8192
AI_HARD_MAX_OUTPUT_TOKENS=16000
AI_MAX_RETRIES=2
# Probe the provider before spending a YouTube fetch (fails fast on 401/402/403/404).
AI_PREFLIGHT_ENABLED=true

# Cost estimation (USD per 1M tokens). Set real prices to enable cost tracking.
AI_PRICE_MAIN_INPUT=0
AI_PRICE_MAIN_OUTPUT=0
AI_PRICE_FAST_INPUT=0
AI_PRICE_FAST_OUTPUT=0

# --- Supabase (authoritative Postgres + Auth) ---
# Apply supabase/migrations/*.sql to the project before starting.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY. Never ship to the extension.
SUPABASE_ANON_KEY=                 # public; used by the extension for sign-in
# Only needed if the project signs JWTs with the legacy HS256 shared secret.
SUPABASE_JWT_SECRET=
# Optional override; defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# auto -> Supabase when configured, else in-memory (development only)
STORAGE_BACKEND=auto
# Production must be true: unauthenticated requests are rejected.
AUTH_REQUIRED=false

# --- Razorpay billing (server-side secrets) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_PLAN_AMOUNT=29900         # smallest currency unit (paise) = ₹299
RAZORPAY_PLAN_NAME=YouTube AI Reader Pro
RAZORPAY_PLAN_PERIOD_DAYS=30

# --- Quotas ---
FREE_VIDEO_LIMIT=3                 # anonymous/install-id limit (development only)
FREE_MONTHLY_VIDEO_LIMIT=3         # free plan: videos per calendar month (UTC)
PRO_MONTHLY_VIDEO_LIMIT=50         # pro plan: videos per billing cycle
FREE_MONTHLY_CHAT_LIMIT=200
FREE_MAX_VIDEO_MINUTES=60          # free plan: max video length (0 disables)
PRO_MAX_VIDEO_MINUTES=180          # pro plan: max video length (0 disables)
QUOTA_ENABLED=true
USAGE_ENABLED=true

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data                    # local cache only; Supabase is authoritative
LOG_POLL_REQUESTS=false

# Comma-separated exact origins. In production set CORS_ALLOW_ORIGIN_REGEX to
# your published extension id (^chrome-extension://<id>$).
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=^(chrome-extension://.*|http://localhost(:\d+)?|http://127\.0\.0\.1(:\d+)?)$
TRUST_PROXY=false                  # true behind Cloudflare/Cloud Run

# --- Transcripts ---
# Accept transcripts captured by the extension (MAIN-world interception).
TRUST_CLIENT_TRANSCRIPTS=true
TRANSCRIPT_FALLBACK_ENABLED=true
MAX_TRANSCRIPT_CHARS=900000
MAX_CHAT_MESSAGE_CHARS=2000
MAX_CONCURRENT_JOBS=3
JOB_QUEUE_TIMEOUT_SECONDS=45
CACHE_ENABLED=true
# Bump to invalidate every cached canonical video (self-heals bad/stale entries).
CACHE_VERSION=3
PROMPT_VERSION=1

# --- YouTube / yt-dlp fallback (anti-throttling) ---
YTDLP_TIMEOUT_SECONDS=180
YTDLP_MAX_RETRIES=2
YTDLP_CONCURRENCY=1
YTDLP_MIN_INTERVAL_SECONDS=4
YTDLP_429_MAX_RETRIES=1
YTDLP_429_BACKOFF_SECONDS=8
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_PLAYER_CLIENT=

# --- Client-facing rate limits (per IP) ---
RATE_LIMIT_PROCESS_PER_HOUR=10
RATE_LIMIT_CHAT_PER_HOUR=60
RATE_LIMIT_GENERAL_PER_MINUTE=240

# --- Analysis sizing ---
CHUNK_TARGET_CHARS=1200
CHUNK_MAX_CHARS=1800
OVERVIEW_CONTEXT_CHARS=14000
ANALYSIS_READING_CONCURRENCY=2
MAX_READING_SECTIONS=8
READING_SECTION_CHARS=10000
CHAT_TOP_K=6
CHAT_CONTEXT_CHARS=12000
