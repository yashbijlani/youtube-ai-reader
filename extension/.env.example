# Build-time configuration for the extension.
# Copy to extension/.env (or .env.local).
#
# Backend URL the side panel calls by default (also changeable at runtime in Settings).
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Hosted checkout page (served from the marketing site so the payment origin
# matches the website registered with Razorpay). Defaults to the production site.
# VITE_CHECKOUT_BASE_URL=https://youtube-ai-reader-mt4h.vercel.app
#
# Supabase project configuration (public values only — never a service-role key).
# Used for account sign-in; the backend verifies the JWT.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
