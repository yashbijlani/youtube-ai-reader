# Build-time configuration for the extension.
# Copy to extension/.env (or .env.local).
#
# Backend URL the side panel calls by default (also changeable at runtime in Settings).
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Supabase project configuration (public values only — never a service-role key).
# Used for account sign-in; the backend verifies the JWT.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
