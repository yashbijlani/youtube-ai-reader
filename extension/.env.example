# Build-time configuration for the extension.
# Copy to extension/.env (or .env.local).
#
# Backend URL the side panel calls by default (also changeable at runtime in Settings).
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# ExtensionPay extension id — must match the id you register at https://extensionpay.com
# (and connect to Stripe there). Payments are checked client-side.
VITE_EXTPAY_ID=youtube-ai-reader
