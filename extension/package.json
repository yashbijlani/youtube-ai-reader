{
  "name": "youtube-ai-reader-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome extension that turns YouTube videos into a readable, searchable, askable AI experience.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:rnd": "vite build --config vite.rnd.config.ts",
    "watch": "node scripts/build.mjs --watch",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "extpay": "^3.1.2",
    "marked": "^15.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
